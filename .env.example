# ---- Service ----
PORT=4102
# Interface to listen on. 127.0.0.1 = this machine only. Use 0.0.0.0 to expose it
# (Docker sets this for you); then API_KEY is mandatory.
HOST=127.0.0.1
# x-api-key value required on /api/*. Mandatory unless HOST is loopback; min 16 chars.
# Generate: node -e "console.log(crypto.randomUUID())"
API_KEY=
# Set to true only behind a trusted reverse proxy (rate limits use X-Forwarded-For).
TRUST_PROXY=false
DATABASE_PATH=./data/leads.db
RATE_LIMIT_PER_MINUTE=30
# Maximum request body size in bytes (default 512 KB).
MAX_BODY_BYTES=524288

# ---- Claude ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FALLBACKS=default
# Parallel Claude calls per batch (keep low to respect your rate limits).
AI_CONCURRENCY=2

# ---- Ideal Customer Profile ----
# Copy config/icp.example.json to config/icp.json and edit it.
ICP_FILE=./config/icp.json
# Only leads scoring at least this get an outreach draft.
OUTREACH_MIN_SCORE=60
SENDER_NAME=
SENDER_COMPANY=
SENDER_OFFER=

# ---- Enrichment (optional, permitted APIs only) ----
# Hunter.io company enrichment + email verification: https://hunter.io/api-keys
HUNTER_API_KEY=
# Minimum milliseconds between Hunter calls.
HUNTER_MIN_GAP_MS=250

# ---- n8n ----
# Google Sheet id used by the Sheets workflows (from the sheet URL).
LEADS_SHEET_ID=
